DATABASE_URL=postgres://nieuwsbrief:nieuwsbrief@localhost:5433/nieuwsbrief

# Root domain the platform runs on. Tenants live on <slug>.<APP_ROOT_DOMAIN>.
# *.localhost resolves to 127.0.0.1 in modern browsers, so subdomains work locally.
APP_ROOT_DOMAIN=localhost:3000
APP_PROTOCOL=http

BETTER_AUTH_SECRET=

# Email-at-rest protection: AES-256-GCM key + separate HMAC key for the blind index.
EMAIL_ENCRYPTION_KEY=
EMAIL_HASH_KEY=

SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zendlijst <no-reply@zendlijst.local>"

# Shared secret for the scheduler endpoint (POST /api/cron/dispatch)
CRON_SECRET=

# Comma-separated emails allowed to approve organisation requests on the root domain
PLATFORM_ADMIN_EMAILS=
